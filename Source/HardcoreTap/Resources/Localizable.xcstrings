    "A 60 BPM loop that plays during a round. It mixes with your music instead of interrupting it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Луп на 60 BPM во время раунда. Микшируется с твоей музыкой, а не прерывает её."
          }
        }
      }
    },
